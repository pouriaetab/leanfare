{
  "name": "leanfare",
  "version": "0.12.1",
  "description": "Makes the AI apps you already use cost less: it works inside them and hands simple work, like reading files and drafting, to cheaper or free models.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "leanfare": "src/cli.ts"
  },
  "files": [
    "src",
    "ui",
    "data/catalog.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "smoke": "bun scripts/smoke.ts",
    "preflight": "bun scripts/preflight.ts",
    "licences": "bun scripts/licences.ts",
    "data": "bun scripts/build-data.ts"
  },
  "keywords": [
    "llm",
    "ai",
    "gateway",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "cost",
    "budget"
  ],
  "devDependencies": {
    "@types/bun": "1.4.3",
    "happy-dom": "20.14.6",
    "typescript": "7.0.2"
  }
}
