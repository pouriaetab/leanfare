{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "scripts", "test"]
}
